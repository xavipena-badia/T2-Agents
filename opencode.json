{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/spark-coder",
  "provider": {
    "opencode": {
      "options": {
        "apiKey": "{env:OPENCODE_API_KEY}"
      }
    },
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://192.168.10.11:4000/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "spark-coder": {
          "name": "Spark Coder"
        }
      }
    },
    "deepseek": {
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-chat": {
          "name": "DeepSeek Chat"
        },
        "deepseek-reasoner": {
          "name": "DeepSeek Reasoner"
        }
      }
    }
  }
}
